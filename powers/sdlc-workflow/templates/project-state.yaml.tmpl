# project-state.yaml Template
# AUTHORITATIVE runtime workflow state

schema_version: "2"
workflow_version: "1.1.0"

# State versioning for optimistic concurrency (R02)
state_version: 1
last_modified_at: "${STARTED_AT}"
last_modified_by: "${ACTOR_ID}"

lifecycle:
  phase: INTAKE
  phase_started_at: "${STARTED_AT}"
  last_transition_at: "${STARTED_AT}"
  last_transition_from: null

milestone:
  id: M1
  name: "${MILESTONE_NAME}"
  target_date: null

requirements:
  total: 0
  by_status:
    DRAFT: 0
    REVIEW: 0
    APPROVED: 0
    FROZEN: 0
    SUPERSEDED: 0

tasks:
  total: 0
  by_status:
    TODO: 0
    READY: 0
    IN_PROGRESS: 0
    BLOCKED: 0
    VERIFY: 0
    DONE: 0
  # Task counts by assignee for workload tracking
  # Key is developer ID, value is number of assigned tasks
  # "unassigned" tracks tasks without an assignee
  by_assignee:
    unassigned: 0
  # Example with team members:
  # by_assignee:
  #   "dev-001": 4                      # Developer dev-001 has 4 tasks
  #   "dev-002": 3                      # Developer dev-002 has 3 tasks
  #   unassigned: 3                     # 3 tasks have no assignee

# Team section for multi-developer support
team:
  members: []
  # Example member structure:
  # - id: "dev-001"                      # Unique identifier (required)
  #   name: "Alice Developer"            # Display name (required)
  #   roles:                             # List of roles (required, min 1)
  #     - backend
  #     - devops
  #   registered_at: "2024-01-15T10:00:00Z"
  #   status: ACTIVE                     # ACTIVE | INACTIVE
  statistics:
    total_members: 0
    by_role:
      frontend: 0
      backend: 0
      qa: 0
      devops: 0
      fullstack: 0
      lead: 0

current_task:
  id: null
  status: null
  assignee: null                       # Developer ID assigned to current task
  # Ownership details for concurrency control (R02)
  ownership:
    fencing_token: null                # UUID generated on claim
    acquired_at: null                  # ISO 8601 timestamp
    actor_type: null                   # HUMAN | AI_AGENT
    lease_expires_at: null             # null for HUMAN, timestamp for AI_AGENT
    last_heartbeat_at: null            # only for AI_AGENT
  # Definition of Ready validation result (R01)
  dor_check:
    passed: null
    checked_at: null
    conditions: []
    # Example condition:
    # - condition: "acceptance_criteria_defined"
    #   passed: true
    # - condition: "blocking_dependencies_done"
    #   passed: true
    # - condition: "required_decisions_resolved"
    #   passed: true
    # - condition: "assignee_has_role"
    #   passed: true
  tdd:
    phase: null
    phase_started_at: null
    not_applicable_reason: null
  # Blocked as orthogonal attribute (R04)
  blocked: false
  blocked_reason: null
  blocker_refs: []
  # Handoff pending as orthogonal attribute (R08)
  handoff_pending: false
  handoff_id: null
  # Working branch for isolation (R03)
  working_branch: null
  # Blocking findings from review (R11)
  blocking_finding_ids: []

# Parallel task groups for multi-developer parallel execution
# Each group contains tasks that can be worked on simultaneously
parallel_groups: []
# Example parallel group entry:
# - id: "PG-001"                       # Unique group identifier (required)
#   name: "Sprint 1 - Core Features"   # Human-readable group name (required)
#   milestone: "M1"                    # Associated milestone ID (optional)
#   tasks:                             # List of task IDs in this group (required, min 1)
#     - "TASK-001"
#     - "TASK-002"
#     - "TASK-003"
#   created_at: "2024-01-15T10:00:00Z" # ISO 8601 timestamp
#   status: PENDING                    # PENDING | IN_PROGRESS | COMPLETE
#   progress:                          # Calculated progress metrics
#     total: 3                         # Total number of tasks
#     completed: 0                     # Number of DONE tasks
#     percentage: 0                    # (completed / total) * 100

# Handoff points definition for role-to-role transitions
# Defines standard handoff procedures with required checklists
handoff_points: []
# Example handoff point entry:
# - id: "HP-001"                       # Unique handoff point identifier (required)
#   name: "Backend to Frontend Handoff" # Human-readable name (required)
#   source_role: "backend"             # Role initiating handoff (required)
#   target_role: "frontend"            # Role receiving handoff (required)
#   checklist:                         # Checklist items for handoff (required, min 1)
#     - id: "CHK-001"                  # Unique checklist item identifier (required)
#       description: "API documentation updated" # Item description (required)
#       required: true                 # Whether item must be completed (required)
#     - id: "CHK-002"
#       description: "Sample request/response provided"
#       required: true
#     - id: "CHK-003"
#       description: "Error codes documented"
#       required: false

# Active handoffs tracking role-to-role transitions
# Records handoff status and checklist completion
handoffs: []
# Example handoff record entry:
# - id: "HO-001"                       # Unique handoff record identifier (required)
#   handoff_point: "HP-001"            # Reference to handoff point definition (required)
#   source_task: "TASK-001"            # Task being handed off (required)
#   target_task: "TASK-005"            # Receiving task (required)
#   source_developer: "dev-001"        # Developer initiating handoff (required)
#   target_developer: null             # Developer accepting handoff (null until accepted)
#   status: PENDING_ACCEPTANCE         # PENDING_ACCEPTANCE | ACCEPTED | REJECTED | COMPLETE
#   checklist_status:                  # Status of each checklist item
#     - item_id: "CHK-001"             # Reference to checklist item id (required)
#       completed: true                # Whether item is complete (required)
#       completed_at: "2024-01-15T12:00:00Z" # ISO 8601 timestamp (null if not completed)
#     - item_id: "CHK-002"
#       completed: false
#       completed_at: null
#   initiated_at: "2024-01-15T11:00:00Z" # ISO 8601 timestamp of handoff initiation (required)
#   accepted_at: null                  # ISO 8601 timestamp of acceptance (null until accepted)
#   completed_at: null                 # ISO 8601 timestamp of completion (null until complete)
#   rejection_reason: null             # Reason for rejection (null unless rejected)

# Resource locks for conflict prevention (R03)
resource_locks: []
# Example resource lock entry:
# - resource_id: "db-migration-slot"   # Unique resource identifier (required)
#   held_by_task: "TASK-003"           # Task holding the lock (required)
#   held_by_owner: "dev-001"           # Owner holding the lock (required)
#   acquired_at: "2024-01-15T10:00:00Z" # ISO 8601 timestamp
#   expires_at: "2024-01-15T14:00:00Z" # 4 hour max, null for no expiry

# Checkpoints summary for crash recovery (R09)
checkpoints:
  last_checkpoint_id: null
  last_checkpoint_at: null
  checkpoint_count: 0

# Findings register summary for review tracking (R11)
findings:
  total: 0
  by_status:
    OPEN: 0
    IN_PROGRESS: 0
    RESOLVED: 0
    WONT_FIX: 0
    DUPLICATE: 0
  by_severity:
    CRITICAL: 0
    HIGH: 0
    MEDIUM: 0
    LOW: 0
    INFO: 0
  blocking_release: 0

blockers:
  count: 0
  ids: []

changes:
  pending: 0
  ids: []

release:
  status: NOT_STARTED
  version: null
  current_stage: null
  # Release stages tracking (R15)
  stages:
    readiness_check:
      status: NOT_STARTED
      completed_at: null
      evidence_id: null
    staging:
      status: NOT_STARTED
      deployed_at: null
      verified_at: null
      evidence_id: null
    production:
      status: NOT_STARTED
      approved_by: null
      approved_at: null
      deployed_at: null
      verified_at: null
      evidence_id: null
  rollback_available: false
  previous_version: null

# Actor configuration for human vs AI agent policies (R12)
actor_config:
  lease_duration_seconds: 3600         # Default lease duration for AI agents
  heartbeat_interval_seconds: 300      # Heartbeat interval for AI agents
  inactivity_warning_seconds: 7200     # Warning for human inactivity
  handoff_timeout_hours: 24            # Handoff timeout before escalation

# Quality gates configuration (R06)
quality_gates:
  unit_test:
    required: true
    min_pass_rate: 100
  integration_test:
    required: true
    min_pass_rate: 100
  lint:
    required: true
  type_check:
    required: true
  security_scan:
    required_for_risk: [HIGH, CRITICAL]

# Integration mode configuration (R07)
integration:
  mode: serial                         # serial | merge_queue | manual
  merge_queue_provider: none           # github | gitlab | none

last_action:
  action: "Project initialized"
  timestamp: "${STARTED_AT}"
  result: SUCCESS
  details: null

next_permitted_actions:
  - capture_idea
  - describe_problem

validation:
  last_validated_at: null
  validation_result: null
  issues: null

# VALIDATION RULES:
# - requirements.total == sum(requirements.by_status.*)
# - tasks.total == sum(tasks.by_status.*)
# - tasks.by_assignee values must sum to tasks.total
# - tasks.by_assignee keys must be valid developer IDs or "unassigned"
# - current_task.id must reference existing TASK-xxx.md if not null
# - current_task.assignee must reference a valid developer ID from team.members or be null
# - If tdd.phase is NOT_APPLICABLE, not_applicable_reason is required
# - blockers.count == len(blockers.ids)
# - handoff_points[].id must be unique across all handoff points
# - handoff_points[].source_role and target_role must be valid roles
# - handoff_points[].checklist must have at least one item
# - handoff_points[].checklist[].id must be unique within the handoff point
# - handoffs[].handoff_point must reference existing handoff_points[].id
# - handoffs[].source_task and target_task must reference existing TASK-xxx.md
# - handoffs[].status must be one of: PENDING_ACCEPTANCE | ACCEPTED | REJECTED | COMPLETE
# - handoffs[].checklist_status[].item_id must reference checklist item from handoff_point
# - If handoffs[].status is COMPLETE, all required checklist items must be completed
# - If handoffs[].status is REJECTED, rejection_reason is required
#
# Team Validation Rules:
# - team.members[].id must be unique across all members
# - team.members[].name is required and non-empty
# - team.members[].roles must contain at least one valid role
# - team.members[].roles values must be: frontend, backend, qa, devops, fullstack, or lead
# - team.members[].status must be: ACTIVE or INACTIVE
# - team.members[].registered_at must be a valid ISO 8601 timestamp
# - team.statistics.total_members == len(team.members)
# - team.statistics.by_role counts must reflect actual role assignments across all members
#
# PARALLEL GROUPS VALIDATION RULES:
# - Each parallel_groups[].id must be unique
# - Each parallel_groups[].tasks[] must reference an existing TASK-xxx.md
# - parallel_groups[].tasks must contain at least 1 task ID
# - parallel_groups[].status must be one of: PENDING, IN_PROGRESS, COMPLETE
# - parallel_groups[].progress.total == len(parallel_groups[].tasks)
# - parallel_groups[].progress.percentage == (completed / total) * 100
# - Tasks within a parallel group must NOT have internal blocking dependencies
# - If milestone is specified, it must reference a valid milestone ID
#
# STATE VERSIONING VALIDATION RULES (R02):
# - state_version must be a positive integer, incremented on every write
# - last_modified_at must be a valid ISO 8601 timestamp
# - last_modified_by must be a valid actor ID
#
# OWNERSHIP VALIDATION RULES (R02):
# - current_task.ownership.fencing_token must be a valid UUID if not null
# - current_task.ownership.actor_type must be one of: HUMAN | AI_AGENT
# - If actor_type is AI_AGENT, lease_expires_at must be set
# - If actor_type is HUMAN, lease_expires_at must be null
# - last_heartbeat_at is only relevant for AI_AGENT
#
# DEFINITION OF READY VALIDATION RULES (R01):
# - current_task.dor_check.conditions must contain all required DoR conditions
# - Each condition must have: condition (string), passed (boolean)
# - dor_check.passed must reflect all conditions passing
#
# BLOCKED STATUS VALIDATION RULES (R04):
# - If blocked is true, blocked_reason must be non-empty
# - blocker_refs must reference valid BLOCKER-xxx IDs
#
# RESOURCE LOCKS VALIDATION RULES (R03):
# - resource_locks[].resource_id must be unique
# - resource_locks[].held_by_task must reference existing task
# - resource_locks[].held_by_owner must reference valid team member
# - expires_at if set must be after acquired_at
#
# CHECKPOINTS VALIDATION RULES (R09):
# - checkpoint_count must be non-negative
# - last_checkpoint_id if set must reference existing checkpoint file
#
# FINDINGS VALIDATION RULES (R11):
# - findings.total == sum of findings.by_status values
# - findings.by_severity values must be non-negative
# - blocking_finding_ids must reference existing FND-xxx IDs
#
# RELEASE VALIDATION RULES (R15):
# - release.status must be one of: NOT_STARTED | PLANNING | READINESS_CHECK | STAGING | etc.
# - If release.current_stage is set, corresponding stage status must not be NOT_STARTED
# - rollback_available can only be true if previous_version is set
#
# ACTOR CONFIG VALIDATION RULES (R12):
# - All timeout/interval values must be positive integers
# - heartbeat_interval_seconds must be less than lease_duration_seconds
#
# QUALITY GATES VALIDATION RULES (R06):
# - min_pass_rate must be between 0 and 100
# - required_for_risk values must be valid risk levels: LOW | MEDIUM | HIGH | CRITICAL
